# Local secrets for `wrangler dev` / `opennextjs-cloudflare preview`.
# Copy to `.dev.vars` (gitignored) and fill in. NEVER commit real values.
#
# These mirror .env.local but are consumed by the Workers runtime during
# Cloudflare previews.

NEXT_PUBLIC_SITE_URL=http://localhost:8787
NEXT_PUBLIC_ROOT_DOMAIN=movonhub.com.my
NEXT_PUBLIC_UNOPTIMIZED_IMAGES=true
NEXT_PUBLIC_ASSETS_BASE_URL=https://assets.movonhub.com.my

SESSION_SECRET=replace-with-a-long-random-string
ADMIN_PASSWORD=replace-with-a-strong-password

# Public self-registration is disabled unless this is "true".
ALLOW_PUBLIC_REGISTRATION=false

# On Cloudflare, the local JSON adapter is NOT durable. Use Supabase.
DATA_ADAPTER=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
