# ---------------------------------------------------------------------------
# MOVONHUB environment variables  (copy to .env.local and fill in)
# NEVER commit real values.
# ---------------------------------------------------------------------------

# Public site URL (no trailing slash). Used for canonical URLs, OG and sitemap.
NEXT_PUBLIC_SITE_URL=https://movonhub.com.my

# Set to "true" on Cloudflare Workers (no built-in Next image optimizer).
NEXT_PUBLIC_UNOPTIMIZED_IMAGES=false

# Public contact WhatsApp for the landing "Contact MOVONHUB" CTA (60XXXXXXXXX).
# Leave blank to fall back to the /contact page. No number is hardcoded.
NEXT_PUBLIC_CONTACT_WHATSAPP=

# Extra reserved advisor subdomains (comma-separated), merged with the built-in list.
RESERVED_SLUGS=

# Root domain used for advisor subdomain routing ({slug}.ROOT_DOMAIN -> /sa/{slug}).
NEXT_PUBLIC_ROOT_DOMAIN=movonhub.com.my

# Signed-cookie session secret. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Admin portal password (server-side only). Username defaults to "admin".
ADMIN_PASSWORD=replace-with-a-strong-password

# Data adapter: "local" (default, file-backed, zero setup) or "supabase".
DATA_ADAPTER=local

# --- Supabase (required when DATA_ADAPTER=supabase) --------------------------
# Server reads SUPABASE_URL at runtime (preferred on Cloudflare, since
# NEXT_PUBLIC_* is inlined at build time). NEXT_PUBLIC_SUPABASE_URL is the
# local-dev fallback. The anon key is optional for this app (server uses service role).
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service role key. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- MOVONHUB AI (optional) --------------------------------------------------
# Provider is abstracted; leave blank to keep the UI in "not configured" state.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# --- Optional defaults -------------------------------------------------------
NEXT_PUBLIC_DEFAULT_ADVISOR=nik
